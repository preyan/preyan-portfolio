---
const lastUpdated = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
})
  .format(new Date())
  .toUpperCase();
---

<footer role="contentinfo" class="footer">
  <div class="links">
    <a href="mailto:preyan1997@gmail.com">preyan1997@gmail.com</a>
    <a href="https://github.com/preyan" target="_blank" rel="noopener noreferrer">GITHUB</a>
    <a href="https://linkedin.com/in/preyan" target="_blank" rel="noopener noreferrer">LINKEDIN</a>
  </div>
  <p class="updated">LAST UPDATED {lastUpdated}</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 2px solid var(--color-ink);
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .links a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .updated {
    color: var(--color-muted);
    margin: 0;
  }
  @media (min-width: 640px) {
    .footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .links {
      flex-direction: row;
      gap: 1.25rem;
    }
  }
</style>
