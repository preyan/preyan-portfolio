---
const lastUpdated = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
})
  .format(new Date())
  .toUpperCase();
---

<footer class="footer">
  <div class="colophon">
    <span>PREYAN.DEV / VOL. I / END</span>
    <span>© 2026 P. BHOWMICK</span>
  </div>

  <div class="utility">
    <nav class="contact" aria-label="Contact links">
      <a href="mailto:preyan1997@gmail.com" aria-label="Email Preyan at preyan1997@gmail.com">
        EMAIL <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a
        href="https://github.com/preyan"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile (opens in new tab)"
      >
        GITHUB <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a
        href="https://linkedin.com/in/preyan"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn profile (opens in new tab)"
      >
        LINKEDIN <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </nav>
    <span class="updated">LAST UPDATED {lastUpdated}</span>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 2px solid var(--color-ink);
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
  }

  .colophon {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
  }

  .utility {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .contact a {
    color: inherit;
    text-decoration: none;
  }
  .contact a:hover,
  .contact a:focus-visible {
    background-color: var(--color-accent);
    padding: 2px 4px;
  }
  .arrow {
    margin-left: 4px;
  }

  .updated {
    color: var(--color-ink);
  }

  @media (min-width: 640px) {
    .footer {
      padding: 1.5rem 2rem;
    }
    .utility {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
</style>
