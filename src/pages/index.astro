---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stamp from '../components/Stamp.astro';

const title = 'Preyan Bhowmick — Full Stack Engineer';
const description =
  'Senior Full Stack Developer at Accenture, based in Kolkata. Seven years shipping production web applications across Angular, Node.js, NestJS, and .NET — focused on performance, mentorship, and software that holds up in the wild.';

const accentureBullets: readonly string[] = [
  'Own full-stack modules end-to-end — Angular on the frontend, NestJS and Mongoose on the backend, MongoDB underneath',
  'Design and ship production REST APIs across Express and NestJS for high-traffic enterprise workloads',
  'Integrate .NET / ASP.NET Core microservices with the Node.js stack to bridge hybrid-architecture client estates',
  'Migrated the backend to a TypeScript-first stack — sharper service contracts and a measurable drop in runtime surprises',
  'Led API performance work — query tuning, indexing, async patterns — cutting median response times by 30%',
  'Mentor junior engineers on architecture, code review, and patterns; contributed to a ~30% lift in team velocity',
];

const capgeminiBullets: readonly string[] = [
  'Shipped full-stack features across Angular, Node.js, and MongoDB; lifted application efficiency by ~20%',
  'Built REST APIs and refactored core backend services — ~30% faster response times in production',
  'Streamlined Azure DevOps pipelines alongside QA and DevOps, cutting deployment time by ~30%',
  'Coordinated sprint planning and delivery across distributed teams using Git and Jira',
];

interface ExpertiseGroup {
  readonly label: string;
  readonly skills: readonly string[];
}

const expertise: readonly ExpertiseGroup[] = [
  {
    label: 'FRONTEND',
    skills: [
      'Angular 2+',
      'TypeScript',
      'JavaScript',
      'RxJS',
      'NGRX',
      'Tailwind',
      'Bootstrap',
      'HTML5',
      'CSS3',
      'PrimeNG',
      'ngBootstrap',
    ],
  },
  { label: 'BACKEND', skills: ['Node.js', 'NestJS', 'Express', 'REST APIs', '.NET'] },
  { label: 'DATABASE', skills: ['MongoDB', 'MySQL', 'Oracle', 'SQL', 'NoSQL'] },
  {
    label: 'DEVOPS & TOOLS',
    skills: ['Azure DevOps', 'GitHub Actions', 'Git', 'Bitbucket', 'Jira', 'Swagger', 'Nx Workspace'],
  },
  { label: 'TESTING', skills: ['Karma', 'Jasmine', 'Postman'] },
  { label: 'UTILITIES', skills: ['Lodash', 'Day.js'] },
];

const comingSoon: readonly string[] = ['Projects showcase', 'Blog'];
---

<BaseLayout title={title} description={description} pageName="HOME">
  <section class="hero">
    <p class="pre-label">PREYAN.DEV / EST. 2026 / IDX 001</p>
    <div class="hero-grid">
      <div class="hero-text">
        <h1>FULL STACK ENGINEER WHO SHIPS.</h1>
        <p class="sub-headline">{description}</p>
        <p class="contact">
          <a href="mailto:preyan1997@gmail.com">preyan1997@gmail.com</a> ·
          <a href="tel:+919836556742">+91 98365 56742</a> · Kolkata, India
        </p>
        <a class="resume-btn" href="/resume.pdf" aria-label="Download resume PDF" download>
          DOWNLOAD RESUME ↓
        </a>
      </div>
      <figure class="polaroid" aria-label="Photo of Preyan Bhowmick">
        <div class="polaroid-stamp">
          <Stamp text="AVAILABLE" variant="available" rotation={-6} />
        </div>
        <img
          src="/preyan.svg"
          alt="Preyan Bhowmick"
          width="320"
          height="320"
          loading="eager"
          decoding="async"
        />
        <figcaption>PREYAN</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="exp-heading">
    <h2 id="exp-heading">EXPERIENCE</h2>

    <article>
      <header class="exp-head">
        <h3>ACCENTURE</h3>
        <p class="exp-meta">Feb 2022 — Present · Kolkata</p>
      </header>
      <p class="exp-role">Senior Full Stack Developer</p>
      <ul class="exp-list">
        {accentureBullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      <p class="exp-awards">AWARDS: Growth Catalyst, Star Performer</p>
    </article>

    <hr />

    <article>
      <header class="exp-head">
        <h3>CAPGEMINI</h3>
        <p class="exp-meta">Jul 2018 — Feb 2022 · Mumbai</p>
      </header>
      <p class="exp-role">Full Stack Developer</p>
      <ul class="exp-list">
        {capgeminiBullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      <p class="exp-awards">
        AWARDS: Xtra Mile, Star Performer, Certificate of Appreciation; Finalist — Burger Hack 2.0
      </p>
    </article>
  </section>

  <section class="section" aria-labelledby="skills-heading">
    <h2 id="skills-heading">EXPERTISE</h2>
    {
      expertise.map((group) => (
        <div class="skill-group">
          <h3>{group.label}</h3>
          <div class="pills">
            {group.skills.map((skill) => (
              <span class="pill">{skill}</span>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <section class="section coming-soon" aria-labelledby="coming-soon">
    <p id="coming-soon" class="pre-label">COMING SOON / VOL. II</p>
    <ul class="coming-list">
      {comingSoon.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 2rem 1.5rem;
  }
  .hero-grid {
    margin-top: 2rem;
    display: flex;
    flex-direction: column-reverse;
    gap: 2.5rem;
    align-items: flex-start;
  }
  .hero-text {
    width: 100%;
  }
  .polaroid {
    position: relative;
    margin: 1.25rem 0 0 0;
    padding: 10px 10px 0 10px;
    background-color: #ffffff;
    border: 3px solid var(--color-ink);
    transform: rotate(3deg);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 200px;
    align-self: center;
    flex-shrink: 0;
  }
  .polaroid img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 2px solid var(--color-ink);
    background-color: var(--color-cream);
  }
  .polaroid figcaption {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    padding: 10px 4px 8px 4px;
    color: var(--color-ink);
  }
  .polaroid-stamp {
    position: absolute;
    top: -18px;
    right: -22px;
    z-index: 2;
  }
  .pre-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    margin: 0;
  }
  .hero h1 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 40px;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 0;
  }
  .sub-headline {
    max-width: 540px;
    font-size: 16px;
    line-height: 1.5;
    margin: 1.5rem 0 0 0;
    font-weight: 400;
  }
  .contact {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
    margin: 1rem 0 0 0;
  }
  .contact a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .resume-btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 18px;
    text-transform: uppercase;
    text-decoration: none;
    border: 3px solid var(--color-ink);
    padding: 1rem 2rem;
    margin-top: 2rem;
    background-color: var(--color-cream);
    color: var(--color-ink);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .resume-btn:hover,
  .resume-btn:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-cream);
  }

  .section {
    padding: 3rem 1.5rem;
    border-top: 2px solid var(--color-ink);
  }
  .section h2 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 32px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0 0 2rem 0;
  }

  .exp-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .exp-head h3 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .exp-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    margin: 0;
  }
  .exp-role {
    font-style: italic;
    font-weight: 500;
    font-size: 17px;
    margin: 0.5rem 0 0 0;
  }
  .exp-list {
    list-style: none;
    padding-left: 0;
    margin-top: 1rem;
  }
  .exp-list li {
    font-size: 15px;
    line-height: 1.6;
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.35rem;
  }
  .exp-list li::before {
    content: '— ';
    position: absolute;
    left: 0;
    color: var(--color-ink);
  }
  .exp-awards {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin-top: 1rem;
  }
  hr {
    border: 0;
    border-top: 1px solid var(--color-ink);
    margin: 2.5rem 0;
  }

  .skill-group {
    margin-bottom: 1.5rem;
  }
  .skill-group h3 {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin: 0 0 0.75rem 0;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-block;
    border: 2px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 6px 10px;
    margin: 4px 8px 4px 0;
    background-color: var(--color-cream);
  }

  .coming-soon {
    padding: 2rem 1.5rem;
  }
  .coming-list {
    list-style: none;
    padding-left: 0;
    margin-top: 1rem;
  }
  .coming-list li {
    font-size: 14px;
    line-height: 1.6;
    position: relative;
    padding-left: 1.25rem;
  }
  .coming-list li::before {
    content: '— ';
    position: absolute;
    left: 0;
  }

  @media (min-width: 768px) {
    .hero {
      padding: 4rem 2rem;
    }
    .hero-grid {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 3rem;
    }
    .hero-text {
      flex: 1 1 auto;
      min-width: 0;
    }
    .polaroid {
      width: 320px;
      margin: 0;
      align-self: flex-start;
    }
    .hero h1 {
      font-size: 72px;
    }
    .section {
      padding: 4rem 2rem;
    }
    .coming-soon {
      padding: 3rem 2rem;
    }
    .exp-head {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }
  }
</style>
