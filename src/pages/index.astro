---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stamp from '../components/Stamp.astro';

const title = 'Preyan Bhowmick — Full Stack Engineer';
const description =
  'Senior Full Stack Developer at Accenture, based in Kolkata. Seven years shipping production web applications across Angular, Node.js, NestJS, and .NET — focused on performance, mentorship, and software that holds up in the wild.';

const accentureBullets: readonly string[] = [
  'Own full-stack modules end-to-end — Angular on the frontend, NestJS and Mongoose on the backend, MongoDB underneath',
  'Design and ship production REST APIs across Express and NestJS for high-traffic enterprise workloads',
  'Integrate .NET / ASP.NET Core microservices with the Node.js stack to bridge hybrid-architecture client estates',
  'Migrated the backend to a TypeScript-first stack — sharper service contracts and a measurable drop in runtime surprises',
  'Led API performance work — query tuning, indexing, async patterns — cutting median response times by 30%',
  'Mentor junior engineers on architecture, code review, and patterns; contributed to a ~30% lift in team velocity',
];

const capgeminiBullets: readonly string[] = [
  'Shipped full-stack features across Angular, Node.js, and MongoDB; lifted application efficiency by ~20%',
  'Built REST APIs and refactored core backend services — ~30% faster response times in production',
  'Streamlined Azure DevOps pipelines alongside QA and DevOps, cutting deployment time by ~30%',
  'Coordinated sprint planning and delivery across distributed teams using Git and Jira',
];

interface Skill {
  readonly name: string;
  readonly primary?: boolean;
}

interface ExpertiseGroup {
  readonly label: string;
  readonly skills: readonly Skill[];
}

const expertise: readonly ExpertiseGroup[] = [
  {
    label: 'FRONTEND',
    skills: [
      { name: 'Angular 2+', primary: true },
      { name: 'TypeScript', primary: true },
      { name: 'JavaScript' },
      { name: 'RxJS' },
      { name: 'NGRX' },
      { name: 'Tailwind' },
      { name: 'Bootstrap' },
      { name: 'HTML5' },
      { name: 'CSS3' },
      { name: 'PrimeNG' },
      { name: 'ngBootstrap' },
    ],
  },
  {
    label: 'BACKEND',
    skills: [
      { name: 'Node.js', primary: true },
      { name: 'NestJS', primary: true },
      { name: 'Express' },
      { name: 'REST APIs' },
    ],
  },
  {
    label: 'DATABASE',
    skills: [
      { name: 'MongoDB', primary: true },
      { name: 'MySQL' },
      { name: 'Oracle' },
      { name: 'SQL' },
      { name: 'NoSQL' },
    ],
  },
  {
    label: 'DEVOPS & TOOLS',
    skills: [
      { name: 'Azure DevOps' },
      { name: 'GitHub Actions' },
      { name: 'Git', primary: true },
      { name: 'Bitbucket' },
      { name: 'Jira' },
      { name: 'Swagger' },
      { name: 'Nx Workspace' },
    ],
  },
  {
    label: 'TESTING',
    skills: [{ name: 'Karma' }, { name: 'Jasmine' }, { name: 'Postman' }],
  },
  {
    label: 'UTILITIES',
    skills: [{ name: 'Lodash' }, { name: 'Day.js' }],
  },
];

const categoryCount = expertise.length.toString().padStart(2, '0');

---

<BaseLayout title={title} description={description} pageName="HOME">
  <section class="hero">
    <p class="pre-label">PREYAN.DEV / EST. 2026 / IDX 001</p>
    <div class="hero-grid">
      <div class="hero-text">
        <h1>FULL STACK ENGINEER<br />WHO SHIPS.</h1>
        <p class="sub-headline">{description}</p>
        <p class="contact">
          <a href="mailto:preyan1997@gmail.com">preyan1997@gmail.com</a> ·
          <a href="tel:+919836556742">+91 98365 56742</a> · Kolkata, India
        </p>
        <div class="cta-row">
          <a class="cta-button cta-outline" href="/projects">
            PROJECTS →
          </a>
          <a class="cta-button cta-outline" href="/blog">
            BLOG →
          </a>
          <a class="cta-button cta-outline" href="/resume.pdf" aria-label="Download resume PDF" download>
            DOWNLOAD RESUME ↓
          </a>
          <a
            class="cta-button cta-filled"
            href="mailto:preyan1997@gmail.com?subject=Hello%20Preyan"
            aria-label="Send Preyan an email"
          >
            CONNECT WITH ME →
          </a>
        </div>
      </div>
      <figure class="headshot" aria-label="Headshot of Preyan Bhowmick">
        <div class="headshot-frame">
          <img
            src="/preyan.jpg"
            alt="Preyan Bhowmick"
            width="354"
            height="475"
            loading="eager"
            decoding="async"
          />
          <div class="headshot-stamp">
            <Stamp text="AVAILABLE FOR HIRE" variant="available" rotation={-3} />
          </div>
        </div>
        <figcaption>
          <span class="headshot-fig">FIG. 01</span>
          <span class="headshot-subject">SUBJECT: P. BHOWMICK</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section experience" aria-labelledby="exp-heading">
    <header class="section-header">
      <h2 id="exp-heading">§ 02 — EXPERIENCE</h2>
      <span class="section-count">ENTRIES / 02</span>
    </header>

    <article class="exp-card">
      <span class="entry-badge">[ENTRY 01]</span>
      <header class="exp-head">
        <div class="exp-head-text">
          <h3>ACCENTURE</h3>
          <p class="exp-role">Senior Full Stack Developer</p>
        </div>
        <div class="date-stamp" aria-label="February 2022 to Present, Kolkata">
          <span>FEB 2022 — PRESENT</span>
          <span>KOLKATA</span>
        </div>
      </header>
      <hr class="exp-rule" />
      <ol class="exp-list">
        {
          accentureBullets.map((bullet, i) => (
            <li>
              <span class="bullet-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="bullet-arrow" aria-hidden="true">→</span>
              <span class="bullet-text">{bullet}</span>
            </li>
          ))
        }
      </ol>
      <div class="awards-badge">
        <span class="awards-label">AWARDS</span>
        <span class="awards-text">Growth Catalyst · Star Performer</span>
      </div>
    </article>

    <article class="exp-card">
      <span class="entry-badge">[ENTRY 02]</span>
      <header class="exp-head">
        <div class="exp-head-text">
          <h3>CAPGEMINI</h3>
          <p class="exp-role">Full Stack Developer</p>
        </div>
        <div class="date-stamp" aria-label="July 2018 to February 2022, Mumbai">
          <span>JUL 2018 — FEB 2022</span>
          <span>MUMBAI</span>
        </div>
      </header>
      <hr class="exp-rule" />
      <ol class="exp-list">
        {
          capgeminiBullets.map((bullet, i) => (
            <li>
              <span class="bullet-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="bullet-arrow" aria-hidden="true">→</span>
              <span class="bullet-text">{bullet}</span>
            </li>
          ))
        }
      </ol>
      <div class="awards-badge">
        <span class="awards-label">AWARDS</span>
        <span class="awards-text"
          >Xtra Mile · Star Performer · Certificate of Appreciation · Finalist Burger Hack 2.0</span
        >
      </div>
    </article>
  </section>

  <section class="section expertise" aria-labelledby="skills-heading">
    <header class="section-header">
      <h2 id="skills-heading">§ 03 — EXPERTISE</h2>
      <span class="section-count">CATEGORIES / {categoryCount}</span>
    </header>
    {
      expertise.map((group) => (
        <div class="skill-group">
          <header class="skill-group-head">
            <h3>{group.label}</h3>
            <span class="skill-group-count">({group.skills.length})</span>
          </header>
          <div class="pills">
            {group.skills.map((skill) => (
              <span class:list={['pill', { 'pill-primary': skill.primary }]}>{skill.name}</span>
            ))}
          </div>
        </div>
      ))
    }
  </section>

</BaseLayout>

<style>
  .hero {
    padding: 2rem 1.5rem;
  }
  .hero-grid {
    margin-top: 2rem;
    display: flex;
    flex-direction: column-reverse;
    gap: 2.5rem;
    align-items: flex-start;
  }
  .hero-text {
    width: 100%;
  }
  .headshot {
    margin: 1.25rem 0 0 0;
    width: 220px;
    align-self: center;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }
  .headshot-frame {
    position: relative;
    border: 3px solid var(--color-ink);
    background-color: var(--color-ink);
    line-height: 0;
  }
  .headshot-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.05);
  }
  .headshot-stamp {
    position: absolute;
    bottom: -14px;
    right: -16px;
    z-index: 2;
  }
  .headshot figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 6px 0 0 0;
    border-top: 1px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink);
  }
  .headshot-subject {
    color: var(--color-muted);
  }
  .pre-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    margin: 0;
  }
  .hero h1 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 40px;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 2rem 0 0 0;
  }
  .sub-headline {
    max-width: 540px;
    font-size: 16px;
    line-height: 1.5;
    margin: 1.5rem 0 0 0;
    font-weight: 400;
  }
  .contact {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
    margin: 1rem 0 0 0;
  }
  .contact a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cta-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 180px;
    padding: 1rem 1.5rem;
    border: 2px solid var(--color-ink);
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .cta-outline {
    background-color: transparent;
    color: var(--color-ink);
  }
  .cta-outline:hover,
  .cta-outline:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-cream);
  }
  .cta-filled {
    background-color: var(--color-ink);
    color: var(--color-cream);
  }
  .cta-filled:hover,
  .cta-filled:focus-visible {
    background-color: transparent;
    color: var(--color-ink);
  }

  @media (min-width: 640px) {
    .cta-row {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .cta-button {
      width: auto;
    }
  }

  .section {
    padding: 3rem 1.5rem;
    border-top: 2px solid var(--color-ink);
  }
  .section h2 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 32px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0 0 2rem 0;
  }

  .section-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 3px solid var(--color-ink);
    margin-bottom: 2.5rem;
  }
  .section-header h2 {
    font-size: 24px;
    margin: 0;
  }
  .section-count {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
  }

  .exp-card {
    position: relative;
    border: 2px solid var(--color-ink);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    background-color: transparent;
  }
  .exp-card:last-of-type {
    margin-bottom: 0;
  }

  .entry-badge {
    position: absolute;
    top: -10px;
    left: 1rem;
    background-color: var(--color-cream);
    padding: 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
  }

  .exp-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .exp-head-text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .exp-head h3 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 22px;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .exp-role {
    font-family: var(--font-sans);
    font-weight: 500;
    font-style: italic;
    font-size: 16px;
    color: var(--color-muted);
    margin: 0.5rem 0 0 0;
  }
  .date-stamp {
    display: flex;
    flex-direction: column;
    align-self: flex-start;
    flex-shrink: 0;
    border: 2px solid var(--color-ink);
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: right;
  }

  .exp-rule {
    border: 0;
    border-top: 1px solid var(--color-ink);
    width: 80px;
    margin: 1.5rem 0;
  }

  .exp-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }
  .exp-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .exp-list li:last-child {
    margin-bottom: 0;
  }
  .bullet-num {
    flex-shrink: 0;
    min-width: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-muted);
  }
  .bullet-arrow {
    flex-shrink: 0;
    margin-right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }
  .bullet-text {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
  }

  .awards-badge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .awards-label {
    background-color: var(--color-accent);
    color: var(--color-ink);
    border: 2px solid var(--color-ink);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .awards-text {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 13px;
    color: var(--color-ink);
  }

  .skill-group {
    margin-bottom: 2rem;
  }
  .skill-group:last-child {
    margin-bottom: 0;
  }
  .skill-group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-ink);
  }
  .skill-group-head h3 {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-ink);
    margin: 0;
  }
  .skill-group-count {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pill {
    display: inline-block;
    padding: 6px 12px;
    border: 2px solid var(--color-ink);
    background-color: transparent;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
  }
  .pill-primary {
    background-color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .hero {
      padding: 4rem 2rem;
    }
    .hero-grid {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 3rem;
    }
    .hero-text {
      flex: 1 1 auto;
      min-width: 0;
    }
    .headshot {
      width: 300px;
      margin: 0;
      align-self: flex-start;
    }
    .hero h1 {
      font-size: 72px;
      margin-top: 4rem;
    }
    .section {
      padding: 4rem 2rem;
    }
    .section-header h2 {
      font-size: 32px;
    }
    .exp-card {
      padding: 2rem;
    }
    .exp-head h3 {
      font-size: 28px;
    }
  }
</style>
