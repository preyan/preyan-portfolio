---
import BaseLayout from '../layouts/BaseLayout.astro';
import { features } from '../config/features';
---

<BaseLayout
  title="404 — Page Not Found · Preyan Bhowmick"
  description="The page you're looking for doesn't exist. Return to the index."
  pageName="404"
>
  <section class="not-found">
    <p class="pre-label">SUBJECT · MISSING PAGE / STATUS · INVESTIGATING</p>

    <div class="number-wrap">
      <h1 class="error-number">404</h1>
      <span class="stamp">INVESTIGATING</span>
    </div>

    <p class="punchline">YOU FOUND A PAGE THAT DOESN'T SHIP.</p>
    <p class="subtext">Ironic, given the headline on the homepage. Let's get you back there.</p>

    <nav aria-label="Recovery options" class="recovery-nav">
      <a href="/" class="back-button back-button--primary">
        <span aria-hidden="true">←</span> BACK TO HOME
      </a>
      {features.showProjects && (
        <a href="/projects" class="back-button">
          PROJECTS <span aria-hidden="true">→</span>
        </a>
      )}
      {features.showBlog && (
        <a href="/blog" class="back-button">
          BLOG <span aria-hidden="true">→</span>
        </a>
      )}
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 8rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .pre-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    margin: 0 0 1.5rem;
    animation: settle 400ms ease-out 100ms both;
  }

  .number-wrap {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .error-number {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(72px, 14vw, 140px);
    line-height: 0.85;
    letter-spacing: -0.06em;
    margin: 0;
    color: var(--color-ink);
    animation: flicker-in 800ms steps(20, end) 300ms both;
  }

  .stamp {
    position: absolute;
    top: -20px;
    right: clamp(-50px, -2vw, -10px);
    background: var(--color-accent);
    border: 3px solid var(--color-ink);
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink);
    transform: rotate(3deg);
    animation: stamp-down 500ms cubic-bezier(0.36, 0, 0.66, -0.2) 1100ms both;
  }

  .punchline {
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.4;
    max-width: 480px;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
    animation: settle 400ms ease-out 1600ms both;
  }

  .subtext {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    max-width: 380px;
    margin: 0 auto 2rem;
    color: var(--color-ink);
    animation: settle 400ms ease-out 1800ms both;
  }

  .recovery-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    animation: settle 400ms ease-out 2000ms both;
  }

  .back-button {
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 12px 24px;
    border: 3px solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    text-decoration: none;
    display: inline-block;
  }
  .back-button:hover,
  .back-button:focus-visible {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .back-button--primary {
    background: var(--color-accent);
  }
  .back-button--primary:hover,
  .back-button--primary:focus-visible {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  @media (max-width: 480px) {
    .recovery-nav {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 280px;
    }
    .back-button {
      text-align: center;
    }
  }

  @media (min-width: 481px) {
    .stamp {
      top: -10px;
      right: -20px;
    }
  }

  @media (min-width: 768px) {
    .stamp {
      right: -50px;
    }
  }

  @keyframes flicker-in {
    0% {
      opacity: 0;
      transform: scale(1.05) skewX(2deg);
      filter: blur(2px);
    }
    20% {
      opacity: 1;
      transform: scale(1.05) skewX(2deg);
      filter: blur(2px);
    }
    35% {
      opacity: 0.3;
      transform: scale(1.05) skewX(-1deg);
      filter: blur(1px);
    }
    50% {
      opacity: 1;
      transform: scale(1.02) skewX(0);
      filter: blur(0);
    }
    65% {
      opacity: 0.6;
      transform: scale(1.02) skewX(0);
      filter: blur(0.5px);
    }
    80%,
    100% {
      opacity: 1;
      transform: scale(1) skewX(0);
      filter: blur(0);
    }
  }

  @keyframes stamp-down {
    0% {
      opacity: 0;
      transform: rotate(-15deg) scale(1.8) translateY(-20px);
    }
    60% {
      opacity: 1;
      transform: rotate(-5deg) scale(1.1) translateY(0);
    }
    85% {
      transform: rotate(5deg) scale(0.96) translateY(0);
    }
    100% {
      opacity: 1;
      transform: rotate(3deg) scale(1) translateY(0);
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pre-label,
    .error-number,
    .stamp,
    .punchline,
    .subtext,
    .recovery-nav {
      animation: none !important;
      opacity: 1 !important;
    }
    .pre-label,
    .error-number,
    .punchline,
    .subtext,
    .recovery-nav {
      transform: none !important;
    }
    .stamp {
      transform: rotate(3deg) !important;
    }
  }
</style>
