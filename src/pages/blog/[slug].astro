---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    // Astro 6 Content Layer: `.id` is the filename slug (e.g. "welcome").
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, description, pubDate, readingTime, tags } = post.data;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
const formattedDate = dateFormatter.format(pubDate).toUpperCase();

// Signature timestamp: published-in-Kolkata feel.
const sigDateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'Asia/Kolkata',
});
const sigTimeFormatter = new Intl.DateTimeFormat('en-GB', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: 'Asia/Kolkata',
});
const signedDate = sigDateFormatter.format(pubDate).toUpperCase();
const signedTime = sigTimeFormatter.format(pubDate);
---

<BaseLayout
  title={`${title} — Preyan Bhowmick`}
  description={description}
  pageName={`BLOG / ${title}`}
>
  <header class="post-header">
    <div class="meta-row">
      <span class="meta-item">{formattedDate}</span>
      {readingTime && <span class="meta-item">{readingTime}</span>}
      {tags.length > 0 && (
        <span class="meta-tags">
          {tags.map((tag) => (
            <span class="meta-tag">{tag}</span>
          ))}
        </span>
      )}
    </div>
    <h1 class="post-title">{title}</h1>
    <p class="post-desc">{description}</p>
    <hr class="header-rule" />
  </header>

  <article class="prose">
    <Content />
    <aside class="signature-block" aria-label="Author signature">
      <span class="signature-name" aria-hidden="true">Preyan</span>
      <span class="sr-only">Signed by Preyan,</span>
      <span class="signature-meta">SIGNED · {signedDate} · {signedTime} IST</span>
    </aside>
  </article>

  <nav class="bottom-nav" aria-label="Blog post navigation">
    <a class="back-link" href="/blog"><span aria-hidden="true">←</span> BACK TO BLOG</a>
  </nav>
</BaseLayout>

<style>
  .post-header {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 2rem 2rem;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  /* Visually separate date/reading-time items with a middot.
     Tags live in their own wrapper so the separator does not bleed into them. */
  .meta-item + .meta-item::before {
    content: '·';
    margin-right: 1rem;
    color: var(--color-muted);
  }

  .meta-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .meta-tag {
    display: inline-block;
    border: 2px solid var(--color-ink);
    padding: 2px 6px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: var(--color-cream);
    color: var(--color-ink);
  }

  .post-title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 32px;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 1.5rem 0 0 0;
  }
  .post-desc {
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-muted);
    font-style: italic;
    margin: 1rem 0 0 0;
  }
  .header-rule {
    border: 0;
    border-top: 2px solid var(--color-ink);
    margin-top: 2rem;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem;
  }

  .signature-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-ink);
  }
  .signature-name {
    font-family: var(--font-signature);
    font-weight: 700;
    font-size: 56px;
    line-height: 1;
    color: var(--color-ink);
    transform: rotate(-3deg);
    transform-origin: left center;
    margin-left: 0.25rem;
    /* slight letter overlap for a more inked feel */
    letter-spacing: -0.02em;
  }
  .signature-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  .bottom-nav {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem;
    border-top: 2px solid var(--color-ink);
  }
  .back-link {
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .back-link:hover,
  .back-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .post-title {
      font-size: 48px;
    }
  }
</style>

<style is:global>
  /* MDX prose styling, scoped under .prose so it never leaks to other pages. */
  .prose h2 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    border-bottom: 2px solid var(--color-ink);
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
  }
  .prose h3 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 20px;
    text-transform: uppercase;
    margin-top: 2rem;
  }
  .prose p {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.7;
    margin-top: 1.25rem;
  }
  .prose ul {
    list-style: none;
    padding-left: 1.5rem;
  }
  .prose ul li {
    position: relative;
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .prose ul li::before {
    content: '— ';
    position: absolute;
    left: -1.25rem;
    color: var(--color-ink);
  }
  .prose ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .prose ol li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .prose code {
    font-family: var(--font-mono);
    background-color: var(--color-accent);
    color: var(--color-ink);
    padding: 1px 6px;
    font-size: 15px;
  }
  .prose pre {
    border: 2px solid var(--color-ink);
    padding: 1.25rem;
    font-family: var(--font-mono);
    font-size: 14px;
    overflow-x: auto;
    background-color: var(--color-cream);
    margin: 1.5rem 0;
  }
  .prose pre code {
    /* Reset the inline-code yellow when nested inside a pre block. */
    background-color: transparent;
    padding: 0;
    font-size: inherit;
  }
  .prose blockquote {
    border-left: 4px solid var(--color-accent);
    padding: 0.5rem 0 0.5rem 1.5rem;
    font-style: italic;
    margin: 1.5rem 0;
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose a:hover,
  .prose a:focus-visible {
    background-color: var(--color-accent);
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--color-ink);
    margin: 2rem 0;
  }
  .prose img {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--color-ink);
    filter: grayscale(1) contrast(1.1);
    margin: 1.5rem 0;
  }
  .prose figure {
    margin: 2rem 0;
  }
  .prose figcaption {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--color-muted);
    letter-spacing: 0.15em;
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
  }
</style>
