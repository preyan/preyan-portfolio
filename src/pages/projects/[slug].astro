---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stamp from '../../components/Stamp.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    // Astro 6 Content Layer: `.id` is the filename slug (e.g. "velora")
    // for the legacy `type: 'content'` collection used here.
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);

const { title, description, stack, liveUrl, codeUrl, npmUrl, status, featured } = project.data;
const statusText = status.toUpperCase();
---

<BaseLayout
  title={`${title} — Preyan Bhowmick`}
  description={description}
  pageName={`PROJECT / ${title}`}
>
  <header class="detail-header">
    <p class="detail-number">#{project.data.id}</p>
    <div class="detail-stamps">
      <Stamp text={statusText} variant={status} rotation={2} />
      {featured && <Stamp text="FEATURED" variant="featured" rotation={-2} />}
    </div>
    <h1 class="detail-title">{title}</h1>
    <p class="detail-desc">{description}</p>
  </header>

  <div class="metadata-strip">
    <div class="pills">
      {stack.map((tech) => <span class="pill">{tech}</span>)}
    </div>
    <div class="meta-links">
      {
        liveUrl && (
          <a
            class="meta-link"
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Live demo (opens in new tab)"
          >
            LIVE <span aria-hidden="true">↗</span>
          </a>
        )
      }
      <a
        class="meta-link"
        href={codeUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Source code on GitHub (opens in new tab)"
      >
        CODE <span aria-hidden="true">↗</span>
      </a>
      {
        npmUrl && (
          <a
            class="meta-link"
            href={npmUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="npm package (opens in new tab)"
          >
            NPM <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </div>

  <article class="prose">
    <Content />
  </article>

  <nav class="bottom-nav" aria-label="Project navigation">
    <a class="back-link" href="/projects">← BACK TO PROJECTS</a>
  </nav>
</BaseLayout>

<style>
  .detail-header {
    padding: 2rem;
    border-bottom: 2px solid var(--color-ink);
  }
  .detail-number {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 24px;
    line-height: 1;
    color: var(--color-muted);
    margin: 0;
  }
  .detail-stamps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .detail-title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 36px;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 1rem 0 0 0;
  }
  .detail-desc {
    font-size: 18px;
    line-height: 1.5;
    max-width: 600px;
    margin: 1rem 0 0 0;
  }

  .metadata-strip {
    padding: 1.5rem 2rem;
    border-bottom: 2px solid var(--color-ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-block;
    border: 2px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 6px 10px;
    margin: 4px 8px 4px 0;
    background-color: var(--color-cream);
    color: var(--color-ink);
  }

  .meta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .meta-link {
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .bottom-nav {
    padding: 2rem;
    border-top: 2px solid var(--color-ink);
  }
  .back-link {
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .detail-title {
      font-size: 56px;
    }
    .metadata-strip {
      flex-direction: row;
      align-items: center;
    }
  }
</style>

<style is:global>
  /* MDX content styling, scoped under .prose so it never leaks to other pages. */
  .prose h2 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--color-ink);
    margin-top: 2rem;
    padding-bottom: 0.5rem;
  }
  .prose h3 {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-top: 1.5rem;
  }
  .prose p {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.7;
  }
  .prose ul {
    list-style: none;
    padding-left: 0;
  }
  .prose ul li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 0.35rem;
  }
  .prose ul li::before {
    content: '— ';
    position: absolute;
    left: 0;
    color: var(--color-ink);
  }
  .prose code {
    font-family: var(--font-mono);
    background-color: var(--color-accent);
    color: var(--color-ink);
    padding: 1px 4px;
    font-size: 14px;
  }
  .prose pre {
    border: 2px solid var(--color-ink);
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 13px;
    overflow-x: auto;
    background-color: var(--color-cream);
  }
  .prose pre code {
    /* Reset the inline-code yellow when nested inside a pre block. */
    background-color: transparent;
    padding: 0;
    font-size: 13px;
  }
  .prose blockquote {
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
    font-style: italic;
    margin-left: 0;
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
